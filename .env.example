ROBOT_GPU_SSH_ALIAS=robot-gpu
OPENPI_REMOTE_DIR=~/src/openpi
OPENPI_WSL_DISTRO=
OPENPI_DATA_HOME=
OPENPI_MIN_FREE_GIB=40
OPENPI_JAX_MEM_FRACTION=0.90
LOCAL_POLICY_HOST=127.0.0.1
LOCAL_POLICY_PORT=8000
REMOTE_POLICY_HOST=127.0.0.1
REMOTE_POLICY_PORT=8000
OPENPI_POLICY_PROFILE=pi05_aloha_base
OPENPI_POLICY_BACKEND=pytorch
OPENPI_CONVERSION_RESTORE_MODE=auto
ALOHA_TASK=gym_aloha/AlohaTransferCube-v0
ALOHA_SCENARIO=transfer_cube
ALOHA_DISPLAY=0
ALOHA_SEED=0
ALOHA_EPISODE_STEPS=300
ALOHA_ACTION_HORIZON=30
ALOHA_PREFETCH_STEPS=25
ALOHA_CHUNK_CROSSFADE_STEPS=0
ALOHA_PROMPT_SCHEDULE=fixed
ALOHA_EPISODES=3
RUN_OUTPUT_DIR=outputs
GPU_METRICS_INTERVAL_SECONDS=1
SSH_CONNECT_TIMEOUT_SECONDS=10
OPENPI_SERVER_STARTUP_TIMEOUT_SECONDS=1800
OPENPI_POLICY_CONNECT_TIMEOUT_SECONDS=60
OPENPI_POLICY_METADATA_TIMEOUT_SECONDS=30
OPENPI_POLICY_INFERENCE_TIMEOUT_SECONDS=300
OPENPI_POLICY_CLOSE_TIMEOUT_SECONDS=10
OPENPI_POLICY_RETRY_COUNT=2
OPENPI_POLICY_RETRY_BACKOFF_SECONDS=2
